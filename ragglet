def responds(api: Api) -> dict[str, Any] | None:
    try:
        return api.get("/v1/stand")
    except Unreachable:
        return None


def services() -> list[tuple[str, str, str | None]]:
    """(имя, адрес, сервис compose) из тех же переменных, что читает сервер; compose — только локальные умолчания."""
    qdrant = os.environ.get("RAGGLET_QDRANT_ENDPOINTS", "http://localhost:6333")
    redis = os.environ.get("RAGGLET_REDIS_URL", "redis://localhost:6379/0")
    found = [("Qdrant", url.strip(), "qdrant") for url in qdrant.split(",") if url.strip()]
    if redis:
        found.append(("Redis", redis, "redis"))
    return [(name, url, svc if address(url) in LOCAL[svc] else None) for name, url, svc in found]


LOCAL = {"qdrant": {("localhost", 6333), ("127.0.0.1", 6333)}, "redis": {("localhost", 6379), ("127.0.0.1", 6379)}}


def address(url: str) -> tuple[str, int]:
    parts = urllib.parse.urlsplit(url)
    default = 6379 if parts.scheme.startswith("redis") else 6333
    return parts.hostname or "localhost", parts.port or default


def port_open(url: str, timeout: float = 1.0) -> bool:
    try:
        with socket.create_connection(address(url), timeout=timeout):
            return True
    except OSError:
        return False


def ensure_services() -> None:
    """Недоступные Qdrant и Redis поднимаются через docker compose; без Docker — команда и выход."""
    down = [(name, url, svc) for name, url, svc in services() if not port_open(url)]
    for name, url, svc in down:
        if svc is None:
            err(f"Warning: {name} at {url} is not reachable; start it yourself")
    startable = sorted({svc for _, _, svc in down if svc})
    if not startable:
        return
    names = " and ".join(f"{name} ({url})" for name, url, svc in down if svc)
    command = COMPOSE + ["up", "-d"] + startable
    if shutil.which("docker") is None:
        err(f"{names} {'is' if len(startable) == 1 else 'are'} down and Docker is not installed. Start them:")
        err("  " + " ".join(command))
        raise Exit(1)
    err(f"{names} {'is' if len(startable) == 1 else 'are'} down, starting with Docker...")
    done = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    if done.returncode != 0:
        err(done.stdout + done.stderr)
        raise Exit(1)
    deadline = time.monotonic() + 60
    while any(not port_open(url) for _, url, svc in down if svc):
        if time.monotonic() > deadline:
            err("Docker started the services, but they do not answer after 60 s: docker compose logs")
            raise Exit(1)
        time.sleep(0.5)


def venv_python() -> Path:
    return ROOT / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")


def prepare_env() -> str:
    """
    Окружение сервера в .venv. С uv — `uv sync --frozen --inexact` на каждом старте: по uv.lock,
    после git pull догоняет новые зависимости, пакеты разработки не трогает. Без uv — один раз
    venv и pip install -e . на Python 3.12+ (версии тогда не по uv.lock).
    """
    python = venv_python()
    uv = shutil.which("uv")
    if uv is None and python.exists():
        return str(python)
    if not python.exists():
        err("Preparing the environment (the first time takes a few minutes)...")
    RESULTS.mkdir(parents=True, exist_ok=True)
    log = RESULTS / "env.log"
    if uv is not None:
        steps = [[uv, "sync", "--frozen", "--inexact"]]
    else:
        base = find_python()
        if base is None:
            err("The server needs Python 3.12+ or uv. Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh")
            raise Exit(1)
        err("Note: without uv the dependencies are not pinned to uv.lock")
        steps = [[base, "-m", "venv", ".venv"], [str(python), "-m", "pip", "install", "-e", "."]]
    with log.open("ab") as sink:
        for step in steps:
            if subprocess.run(step, cwd=ROOT, stdin=subprocess.DEVNULL, stdout=sink, stderr=subprocess.STDOUT).returncode:
                err(f"Failed: {' '.join(step)}; last lines of {log}:")
                err(tail(log))
                raise Exit(1)
    return str(python)


def find_python() -> str | None:
    for name in ("python3.14", "python3.13", "python3.12", "python3"):
        exe = shutil.which(name)
        if exe and subprocess.run([exe, "-c", "import sys; sys.exit(sys.version_info < (3, 12))"]).returncode == 0:
            return exe
    return None


def tail(path: Path, lines: int = 20) -> str:
    try:
        return "\n".join(path.read_text(encoding="utf-8", errors="replace").splitlines()[-lines:])
    except OSError:
        return ""


def server_command(python: str, host: str, port: int) -> list[str]:
    return [python, "-m", "ragglet.server", "--host", host, "--port", str(port)]


def server_env() -> dict[str, str]:
    env = dict(os.environ)
    if "RAGGLET_UI_DIR" not in env and (ROOT / "web" / "dist" / "index.html").is_file():
        env["RAGGLET_UI_DIR"] = "web/dist"  # собранный UI (ragglet-31) — по тому же адресу
    return env


def cmd_start(args: argparse.Namespace) -> int:
    host = "127.0.0.1" if args.host in ("0.0.0.0", "::", "") else args.host
    url = f"http://{host}:{args.port}"
    state = read_state()
    for known in dict.fromkeys([url, state.get("url")]):
        if known and (stand := responds(Api(known))) is not None:
            return started(known, stand, args, already=True)
    if os.name == "nt":
        err("The server runs on macOS and Linux; on Windows use Docker or WSL.")
        return 1
    if not (ROOT / "src" / "ragglet").is_dir():
        err(f"{ROOT} is not a ragglet checkout: keep {Path(__file__).name} in the repository root")
        return 1
    if not args.no_services:
        ensure_services()
    python = prepare_env()
    command = server_command(python, args.host, args.port)
    if args.foreground:
        os.chdir(ROOT)
        os.execve(command[0], command, server_env())  # Ctrl-C останавливает сервер
    RESULTS.mkdir(parents=True, exist_ok=True)
    log = RESULTS / "server.log"
    err(f"Starting the server, log: {display(log)}")
    with log.open("ab") as sink:
        process = subprocess.Popen(command, cwd=ROOT, env=server_env(), stdin=subprocess.DEVNULL, stdout=sink,
                                   stderr=subprocess.STDOUT, start_new_session=True)
    (RESULTS / "server.json").write_text(json.dumps({
        "pid": process.pid, "url": url, "started_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }), encoding="utf-8")
    deadline = time.monotonic() + 120  # импорт FastAPI и ядра, скан реестра
    while (stand := responds(Api(url))) is None:
        if process.poll() is not None or time.monotonic() > deadline:
            if process.poll() is None:
                process.terminate()
            (RESULTS / "server.json").unlink()
            err(f"The server did not start; last lines of {display(log)}:")
            err(tail(log))
            return 1
        time.sleep(0.3)
    return started(url, stand, args, already=False)


def started(url: str, stand: dict[str, Any], args: argparse.Namespace, *, already: bool) -> int:
    if args.json:
        emit_json(stand)
    else:
        if already:
            echo_stand(url, stand)
        out(f"Ragglet is {'already ' if already else ''}running: {url} (API /v1, docs /v1/docs)")
    if args.open:
        webbrowser.open(url)
    return 0


def display(path: Path) -> str:
    try:
        return str(path.relative_to(Path.cwd()))
    except ValueError:
        return str(path)


def alive(pid: int) -> bool:
    try:
        if os.waitpid(pid, os.WNOHANG)[0] == pid:  # наш потомок (тесты) — уже вышел
            return False
    except ChildProcessError:
        pass
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def confirm(question: str) -> bool:
    if not sys.stdin.isatty():
        err(f"{question} [y/N]: no terminal to ask; cancel the tasks first ({CMD} cancel <id>)")
        return False
    return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")


def cmd_stop(args: argparse.Namespace) -> int:
    state = read_state()
    pid, url = state.get("pid"), state.get("url") or api_url(args)
    code = 0
    if not pid or not alive(pid):
        (RESULTS / "server.json").unlink(missing_ok=True)
        if responds(Api(url)) is not None:
            err(f"The server at {url} was not started by `{CMD} start`; stop it where it runs.")
            code = 1
        else:
            out("The server is not running")
    else:
        try:
            active = Api(url).get("/v1/tasks")
        except Unreachable:
            active = []
        if active:
            names = ", ".join(f"{t['kind']} {t['id']} ({t['state']})" for t in active)
            if not confirm(f"Active tasks: {names}. Stopping the server fails them. Stop anyway?"):
                return 1
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 15  # cancel_grace_s сервера и запас
        while alive(pid):
            if time.monotonic() > deadline:
                os.kill(pid, signal.SIGKILL)
                break
            time.sleep(0.2)
        (RESULTS / "server.json").unlink(missing_ok=True)
        out("Stopped the server")
    if args.services:
        if shutil.which("docker") is None:
            err("Docker is not installed: nothing to stop")
            return 1
        if subprocess.run(COMPOSE + ["stop", "qdrant", "redis"], cwd=ROOT).returncode:
            return 1
        out("Stopped Qdrant and Redis")
    return code


def cmd_status(args: argparse.Namespace) -> int:
    url = api_url(args)
    stand = responds(Api(url))
    if stand is None:
        if args.json:
            emit_json({"url": url, "server": None})
        else:
            out(f"server: not running at {url} ({CMD} start)")
            for name, svc_url, _ in services():
                out(f"{name.lower()}: {svc_url} {'up' if port_open(svc_url) else 'down'}")
        return 3
    if args.json:
        emit_json(stand)
    else:
        echo_stand(url, stand)
    return 0


def echo_stand(url: str, stand: dict[str, Any]) -> None:
    state = read_state()
    line = f"server: {url}"
    if state.get("url") == url and state.get("pid"):
        since = parse_time(state.get("started_at"))
        up = (datetime.now(timezone.utc) - since).total_seconds() if since else None
        line += f", pid {state['pid']}, up {clock(up)}, log {display(RESULTS / 'server.log')}"
    out(line)
    for svc in stand.get("qdrant") or []:
        out("qdrant: " + service_line(svc))
    out("redis: " + (service_line(stand["redis"]) if stand.get("redis") else "not configured"))
    compute = stand.get("compute") or {}
    if compute:
        out(f"compute: {compute.get('device')}, {compute.get('torch_threads')} torch threads")
    out(f"commit: {(stand.get('commit') or '-')[:12]}, python {stand.get('python')}")
    current = stand.get("current")
    out(f"running: {current['kind']} {current['id']} {task_progress(current)}" if current else "running: nothing")
    out(f"queued: {stand.get('queued', 0)}")


def service_line(svc: dict[str, Any]) -> str:
    if not svc.get("available"):
        return f"{svc['url']} down ({svc.get('error')})"
    extra = f", {svc['collections']} collections" if svc.get("collections") is not None else ""
    return f"{svc['url']} up, {svc.get('version')}{extra}"


