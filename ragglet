def echo_live(task: dict[str, Any]) -> None:
    state = task["state"]
    if state == "queued":
        state += f", position {task.get('position')}"
    elif state == "running":
        state += f", {task.get('phase')}"
    if task.get("progress"):
        p = task["progress"]
        state += f", {p['stage']} {p['done']}/{p['total']}"
    out(f"state: {state}")
    started, finished = parse_time(task.get("started_at")), parse_time(task.get("finished_at"))
    times = f"queued {short_time(task.get('enqueued_at'))}"
    if started:
        times += f", started {short_time(task.get('started_at'))}"
    if started and finished:
        times += f", took {clock((finished - started).total_seconds())}"
    out(f"time: {times}")


def echo_error(task: dict[str, Any]) -> None:
    error = task.get("error")
    if not error:
        return
    if error.get("problem"):
        echo_problem(error["problem"])
    else:
        qid = f" (qid={error['qid']})" if error.get("qid") else ""
        err(f"error: {error['type']}: {error['message']}{qid}")


def cmd_runs_files(args: argparse.Namespace) -> int:
