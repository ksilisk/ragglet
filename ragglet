class Unreachable(Exception):
    """Сервер не отвечает или отвечает не ragglet: код 3."""


class ApiError(Exception):
    """Ответ не 2xx с телом Problem: 422 — код 2, остальное — 1."""

    def __init__(self, status: int, problem: dict[str, Any]):
        super().__init__(problem.get("title", ""))
        self.status = status
        self.problem = problem


class Exit(Exception):
    def __init__(self, code: int):
        super().__init__(code)
        self.code = code


def die_by_sigint() -> int:
    """
    Выйти сигналом SIGINT, а не exit(130): иначе `for` в bash после Ctrl-C идёт на следующую
    итерацию — он останавливается, только если дочерний процесс умер от SIGINT.
    """
    sys.stdout.flush()
    sys.stderr.flush()
    if os.name != "nt":
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        os.kill(os.getpid(), signal.SIGINT)
        time.sleep(1)
    return 130


