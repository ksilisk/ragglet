def build_parser() -> argparse.ArgumentParser:
    # --api и --json — в любом месте команды: у подкоманд SUPPRESS, чтобы не затирать значение корня
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--api", default=argparse.SUPPRESS, help="server URL (default: RAGGLET_API_URL, "
                        "then the server started by `start`, then http://127.0.0.1:8000)")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print the raw API response")

    parser = argparse.ArgumentParser(prog=CMD, usage=f"{CMD} <command> [options]", epilog=EPILOG,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--api", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--json", action="store_true", default=False, help=argparse.SUPPRESS)
    # плоский список argparse скрыт: его заменяет список по группам в description
    commands = parser.add_subparsers(dest="command", metavar="<command>", help=argparse.SUPPRESS, prog=CMD)
    nested: dict[str, Any] = {}  # группа команд -> её подкоманды: list, show, …

    def command(name: str, func: Callable[[argparse.Namespace], int], help_text: str,
                group: Any = commands) -> argparse.ArgumentParser:
        listed = {} if group is commands else {"help": help_text}  # у вложенных — список argparse
        sub = group.add_parser(name, parents=[common], description=help_text, **listed)
        sub.set_defaults(func=func)
        return sub

    run = command("run", lambda a: submit(a, "runs"), "run a scenario: a YAML file or an id from the library")
    run.add_argument("config", metavar="SCENARIO", help="scenario.yaml or scenario id")
    run.add_argument("--dry-run", action="store_true", help="only check the dataset and the index")
    run.add_argument("--tag", action="append", help="tag of the run in the registry (repeatable)")
    run.add_argument("--no-wait", action="store_true", help="queue the run, print its id and exit")

    build = command("build", lambda a: submit(a, "builds"), "build an index: a profile YAML file or an id")
    build.add_argument("config", metavar="PROFILE", help="profile.yaml or index profile id")
    build.add_argument("--dry-run", action="store_true", help="only check the dataset and the storage")
    build.add_argument("--no-wait", action="store_true", help="queue the build, print its id and exit")

    command("cancel", cmd_cancel, "cancel a queued or running run or build").add_argument("id")
    log = command("log", cmd_log, "print the task log of a run or build")
    log.add_argument("id")
    log.add_argument("--follow", action="store_true", help="keep reading until the task finishes")
    command("queue", cmd_queue, "the running task and the queue")

    start = command("start", cmd_start, "start the stand: services, environment, server; prints the UI address")
    start.add_argument("--port", type=int, default=8000)
    start.add_argument("--host", default="127.0.0.1", help="bind address; 0.0.0.0 opens the server to the network")
    start.add_argument("--open", action="store_true", help="open the UI in the browser")
    start.add_argument("--no-services", action="store_true", help="do not start Qdrant and Redis with Docker")
    start.add_argument("--foreground", action="store_true", help="run the server in this terminal (Ctrl-C stops)")
    stop = command("stop", cmd_stop, "stop the server started by start")
    stop.add_argument("--services", action="store_true", help="also stop Qdrant and Redis (docker compose)")
    command("status", cmd_status, "services, server, running task and queue")

    for group, noun, source in (("scenarios", "scenario", "scenario id or run id"),
                                ("profiles", "index profile", "profile id or build id")):
        lib = commands.add_parser(group, description=f"the {noun} library on the server")
        lib.set_defaults(group=group)
        actions = nested[group] = lib.add_subparsers(dest="action", metavar="<action>", required=True)
        command("list", cmd_lib_list, f"{noun}s of the library", actions)
        command("show", cmd_lib_show, f"print the {noun} YAML", actions).add_argument("id")
        command("edit", cmd_lib_edit, f"edit the {noun} in $EDITOR", actions).add_argument("id")
        new = command("new", cmd_lib_new, f"a new {noun} copied from another", actions)
        new.add_argument("id", help="id of the new entry")
        new.add_argument("--from", dest="source", required=True, help=source)
        command("check", cmd_lib_check, f"dry-run of the {noun}", actions).add_argument("id")
        command("delete", cmd_lib_delete, f"delete the {noun} (asks first)", actions).add_argument("id")

    runs = commands.add_parser("runs", description="runs in the registry")
    actions = nested["runs"] = runs.add_subparsers(dest="action", metavar="<action>", required=True)
    listing = command("list", cmd_runs_list, "runs with summary columns", actions)
    listing.add_argument("--state", choices=["queued", "running", "completed", "failed", "cancelled"])
    listing.add_argument("--scenario", help="scenario name")
    listing.add_argument("--tag")
    listing.add_argument("-n", type=int, default=20, help="how many (default 20)")
    listing.add_argument("-k", type=int, default=10, help="k for ndcg and recall (default 10)")
    command("show", cmd_runs_show, "summary, conditions, warnings, error", actions).add_argument("id")
    command("files", cmd_runs_files, "artifacts of the run", actions).add_argument("id")
    export = command("export", cmd_runs_export, "download the artifacts", actions)
    export.add_argument("id")
    export.add_argument("--zip", action="store_true", help="keep the zip instead of extracting")
    export.add_argument("-o", default=".", metavar="DIR", help="where to put them (default: current directory)")
    queries = command("queries", cmd_runs_queries, "per-query rows", actions)
    queries.add_argument("id")
    queries.add_argument("--outcome", choices=["ok", "timeout", "error"])
    queries.add_argument("--miss", action="store_true", help="only queries without a relevant document in top k")
    queries.add_argument("-n", type=int, default=50, help="how many (default 50)")
    queries.add_argument("-k", type=int, default=10, help="k for --miss (default 10)")

    builds = commands.add_parser("builds", description="index builds in the registry")
    actions = nested["builds"] = builds.add_subparsers(dest="action", metavar="<action>", required=True)
    command("list", cmd_builds_list, "builds", actions).add_argument("-n", type=int, default=20)
    command("show", cmd_builds_show, "one build", actions).add_argument("id")
    command("indexes", cmd_indexes, "collections in Qdrant and their state")
    parser.description = "Ragglet stand client: every command goes through the server's REST API.\n\n" + \
        command_list(commands.choices, nested)
    return parser


def command_list(choices: dict[str, argparse.ArgumentParser], nested: dict[str, Any]) -> str:
    """Команды по группам GROUPS; описание — description подкоманды, у групп — их подкоманды."""
    width = max(len(name) for name in choices)
    lines = []
    for group, names in GROUPS.items():
        lines += [""] if lines else []
        lines.append(f"{group}:")
        for name in names:
            about = choices[name].description or ""
            if name in nested:
                about += ": " + ", ".join(nested[name].choices)
            lines.append(f"  {name:<{width}}  {about}")
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    try:
        return args.func(args)
    except ApiError as e:
        if args.json:
            emit_json(e.problem)
        else:
            echo_problem(e.problem)
        return 2 if e.status == 422 else 1
    except Unreachable as e:
        err(f"Error: {e}.")
        err(f"Start the stand: {CMD} start (or set --api / RAGGLET_API_URL).")
        return 3
    except Exit as e:
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
