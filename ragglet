def editor_command() -> list[str]:
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or ("notepad" if os.name == "nt" else "vi")
    return shlex.split(editor, posix=os.name != "nt")


def cmd_lib_edit(args: argparse.Namespace) -> int:
    """GET, временный файл, $EDITOR, PUT с etag: правка поверх чужой — 409, текст не теряется."""
    api = Api(api_url(args))
    path = entry_path(args.group, args.id)
    doc = api.get(path)
    draft = Path(tempfile.mkdtemp(prefix="ragglet-")) / f"{args.id}.yaml"
    draft.write_text(doc["yaml"], encoding="utf-8")
    if subprocess.run(editor_command() + [str(draft)]).returncode:
        err(f"The editor failed; the text is in {draft}")
        return 1
    text = draft.read_text(encoding="utf-8")
    if text == doc["yaml"]:
        out("No changes")
        shutil.rmtree(draft.parent, ignore_errors=True)
        return 0
    try:
        saved = api.call("PUT", path, {"yaml": text, "etag": doc["etag"]})
    except ApiError as e:
        if e.status == 409:
            err(f"{args.id} changed on the server since you opened it. Your text is kept in {draft}")
            return 1
        if e.status == 422:
            echo_problem(e.problem)
            err(f"Not saved. Your text is kept in {draft}")
            return 2
        raise
    shutil.rmtree(draft.parent, ignore_errors=True)
    return saved_note(args, saved, "Saved")


def saved_note(args: argparse.Namespace, doc: dict[str, Any], verb: str) -> int:
    if args.json:
        emit_json(doc)
    elif doc["valid"]:
        out(f"{verb} {doc['id']}")
    else:
        out(f"{verb} {doc['id']} as a draft")
        if doc.get("problem"):
            echo_problem(doc["problem"])
    return 0


def rename(text: str, key: str, value: str) -> str:
    """Новый id в тексте: строка верхнего уровня `name:` (у профиля `id:`); комментарии остаются."""
    pattern = re.compile(rf"^{key}[ \t]*:.*$", re.MULTILINE)
    if not pattern.search(text):
        err(f"No top-level `{key}:` line to rename")
        raise Exit(2)
    return pattern.sub(f'{key}: "{value}"', text, count=1)


def cmd_lib_new(args: argparse.Namespace) -> int:
    """Копия записи библиотеки под новым id; у сценария источником может быть прогон, у профиля — сборка."""
    api = Api(api_url(args))
    spec = LIBRARY[args.group]
    try:
        source = api.get(entry_path(args.group, args.source))["yaml"]
    except ApiError as e:
        if e.status not in (404, 422):
            raise
        source = None
    if source is None and args.group == "scenarios":
        created = api.call("POST", "/v1/scenarios", {"from_run": args.source, "name": args.id})
        return saved_note(args, created, "Created")
    if source is None:
        source = api.get(f"/v1/builds/{urllib.parse.quote(args.source, safe='')}", include="profile")["profile_yaml"]
    created = api.call("POST", f"/v1/{spec['path']}", {"yaml": rename(source, spec["key"], args.id)})
    return saved_note(args, created, "Created")


