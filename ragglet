KINDS = {
    "runs": {"library": "scenarios", "field": "scenario", "ref": "scenario_id", "noun": "scenario",
             "warnings": "Preflight warnings", "finishing": "writing summary",
             "preparing": "preflight, loading models"},
    "builds": {"library": "index-profiles", "field": "profile", "ref": "profile_id", "noun": "index profile",
               "warnings": "Dataset warnings", "finishing": "writing index metadata",
               "preparing": "dataset, loading the model"},
}


def load_config(api: Api, kind: str, arg: str) -> tuple[str, str | None]:
    """Путь к файлу — его текст без ссылки; иначе id библиотеки сервера — его YAML и ссылка."""
    path = Path(arg)
    if path.is_file():
        return path.read_text(encoding="utf-8"), None
    spec = KINDS[kind]
    try:
        doc = api.get(f"/v1/{spec['library']}/{urllib.parse.quote(arg, safe='')}")
    except ApiError as e:
        if e.status in (404, 422):
            err(f"{arg}: no such file and no such {spec['noun']} in the library")
            raise Exit(1) from e
        raise
    return doc["yaml"], arg


def submit(args: argparse.Namespace, kind: str) -> int:
    api = Api(api_url(args))
    spec = KINDS[kind]
    text, ref = load_config(api, kind, args.config)
    body: dict[str, Any] = {spec["field"]: text, spec["ref"]: ref, "dry_run": args.dry_run}
    if kind == "runs":
        body["tags"] = args.tag or []
    try:
        answer = api.call("POST", f"/v1/{kind}", body, timeout=None)  # preflight синхронный, hf качается
    except KeyboardInterrupt:
        err(f"Interrupted before the server answered; it may still queue the task: {CMD} queue")
        return die_by_sigint()
    if args.json and (args.dry_run or args.no_wait):
        emit_json(answer)
        return 0
    if args.dry_run:
        (echo_run_check if kind == "runs" else echo_build_check)(answer)
        return 0
    if not args.json:
        echo_warnings(spec["warnings"], answer.get("warnings") or [])
    if args.no_wait:
        out(answer["id"])
        err(f"{'Queued' if answer['state'] == 'queued' else 'Started'}: {answer['id']}. "
            f"Follow: {CMD} log {answer['id']} --follow")
        return 0
    return watch(api, kind, answer["id"], json_out=args.json)


def echo_run_check(check: dict[str, Any]) -> None:
    dataset, index, plan = check["dataset"], check.get("index") or {}, check["plan"]
    chunking = str(index.get("chunking_method"))
    if index.get("chunk_size") is not None:
        chunking += f" {index['chunk_size']}/{index['chunk_overlap']}"
    load = plan.get("load") or {}
    params = ", ".join(f"{k} {v}" for k, v in load.items() if k != "type")
    out("Preflight: " + color("OK", "32"))
    out(f"scenario: {check['scenario']}")
    out(f"dataset: {dataset['label']}")
    out(f"split: {dataset['split']}, queries: {dataset['queries']}")
    out(f"corpus sha256: {dataset['corpus_sha256']}")
    out(f"eval sha256: {dataset['eval_sha256']}")
    out(f"index: {index.get('index_profile_id')}, built {index.get('built_at')}")
    out(f"embedding: {index.get('embedding_model')}@{index.get('embedding_revision')}")
    out(f"chunking: {chunking}")
    repeats = plan["repeats"]
    out(f"plan: {plan['queries_per_repeat']} queries x {repeats} repeat{'s' if repeats != 1 else ''}, "
        f"load {load.get('type')}" + (f" ({params})" if params else ""))
    for t in check.get("targets") or []:
        out(f"target {t['id']}: {t['collection']} at {t['endpoint']}, {t['status']}, {cell(t['points'])} points")
    echo_warnings("Preflight warnings", check.get("warnings") or [])


def echo_build_check(check: dict[str, Any]) -> None:
    echo_warnings("Dataset warnings", check.get("warnings") or [])
    out(f"dataset: {check['dataset']}, documents: {check['documents']}")
    out(f"corpus sha256: {check['corpus_sha256']}")
    for t in check.get("targets") or []:
        if not t["reachable"]:
            state = f"unreachable: {t.get('error')}"
        elif not t.get("exists"):
            state = "does not exist yet"
        else:
            state = f"exists, {cell(t.get('points'))} points, built {cell(t.get('built_at'))}"
            if t.get("used_by"):
                state += f", used by: {', '.join(t['used_by'])}"
        out(f"will recreate: {t['collection']} at {t['endpoint']} (target {t['id']}); {state}")


