class Bar:
    """Полоса прогресса одной строкой через \\r в stderr — только в терминале."""

    def __init__(self) -> None:
        self.tty = sys.stderr.isatty()
        self.shown = False

    def draw(self, progress: dict[str, Any]) -> None:
        if not self.tty:
            return
        sys.stderr.write("\r" + bar_line(progress) + "\033[K")
        sys.stderr.flush()
        self.shown = True

    def close(self) -> None:
        if self.shown:
            sys.stderr.write("\n")
            sys.stderr.flush()
            self.shown = False


def bar_line(progress: dict[str, Any], width: int = 30) -> str:
    done, total = progress["done"], progress["total"]
    filled = int(width * done / total) if total else 0
    first, updated = parse_time(progress.get("first_at")), parse_time(progress.get("updated_at"))
    spent = (updated - first).total_seconds() if first and updated else None
    line = f"{progress['stage']} [{'#' * filled}{'-' * (width - filled)}] {done}/{total}  {clock(spent)}"
    if spent and 0 < done < total:
        line += f"  ~{clock(spent / done * (total - done))} left"
    return line


def watch(api: Api, kind: str, task_id: str, *, json_out: bool = False) -> int:
    """Опрос раз в секунду до конца задачи; Ctrl-C отменяет её на сервере."""
    bar = Bar()
    seen: tuple[Any, ...] = ()
    try:
        while True:
            status = api.get(f"/v1/{kind}/{task_id}")
            if not json_out:
                seen = show_status(api, kind, status, seen, bar)
            if status["state"] in TERMINAL:
                bar.close()
                return finish(api, kind, status, json_out)
            sleep(POLL_S)
    except KeyboardInterrupt:
        bar.close()
        return cancel_on_interrupt(api, kind, task_id)
    except Unreachable as e:
        bar.close()
        raise Unreachable(f"lost connection to the server while waiting for {task_id} ({e}); "
                          f"check later: {CMD} runs show {task_id}") from e


def show_status(api: Api, kind: str, status: dict[str, Any], seen: tuple[Any, ...], bar: Bar) -> tuple[Any, ...]:
    """Строка на каждую смену состояния или фазы; в фазе progress — полоса."""
    state, phase, progress = status["state"], status.get("phase"), status.get("progress")
    key = (state, phase, status.get("position"))
    if key != seen:
        if seen[1:2] == ("progress",) and progress:
            bar.draw(progress)  # последнее значение перед finishing или концом
        bar.close()
        spec = KINDS[kind]
        if state == "queued":
            err(f"Queued: {status['id']} (position {status.get('position')}{running_now(api, status['id'])})")
        elif state == "running":
            if seen[:1] != ("running",):
                err(f"Started: {status['id']}")
            if phase == "preparing":
                err(f"Preparing ({spec['preparing']})...")
            elif phase == "finishing":
                err(f"Finishing ({spec['finishing']})...")
    if phase == "progress" and progress:
        bar.draw(progress)
    return key


def running_now(api: Api, task_id: str) -> str:
    current = [t for t in api.get("/v1/tasks") if t["state"] == "running" and t["id"] != task_id]
    return f"; running now: {current[0]['kind']} {current[0]['id']}" if current else ""


def finish(api: Api, kind: str, status: dict[str, Any], json_out: bool) -> int:
    state = status["state"]
    if state == "completed" and kind == "runs":
        status = api.get(f"/v1/runs/{status['id']}", include="summary")
    if json_out:
        emit_json(status)
        return task_code(status)
    if state == "completed":
        if kind == "runs":
            out("Done")
            echo_summary((status.get("summary") or {}).get("aggregate") or {})
            out(f"Artifacts: {status['run_dir']} (on the server)")
        else:
            documents = (status.get("result") or {}).get("documents")
            out(f"Done: {cell(documents)} documents")
            for t in status.get("targets") or []:
                out(f"  {t['collection']} at {t['endpoint']}")
        return 0
    if state == "cancelled":
        err("Cancelled" + progress_note(status))
        return 1
    echo_failure(api, kind, status)
    return task_code(status)


def task_code(status: dict[str, Any]) -> int:
    if status["state"] == "completed":
        return 0
    error = status.get("error") or {}
    return 2 if status["state"] == "failed" and error.get("problem") else 1


def progress_note(status: dict[str, Any]) -> str:
    p = status.get("progress")
    return f" at {p['stage']} {p['done']}/{p['total']}" if p else ""


def echo_failure(api: Api, kind: str, status: dict[str, Any]) -> None:
    error = status.get("error") or {}
    if error.get("problem"):
        echo_problem(error["problem"])
        return
    qid = f" (qid={error['qid']})" if error.get("qid") else ""
    err(f"Failed{progress_note(status)}: {error.get('type')}: {error.get('message')}{qid}")
    tail = read_log(api, kind, status["id"]).rstrip("\n").splitlines()[-20:]
    if tail:
        err("--- last lines of the task log ---")
        err("\n".join(tail))
    err(f"Full log: {CMD} log {status['id']}")


def read_log(api: Api, kind: str, task_id: str, offset: int = 0) -> str:
    parts = []
    while True:
        chunk = api.get(f"/v1/{kind}/{task_id}/log", offset=offset)
        if not chunk["text"]:
            return "".join(parts)
        parts.append(chunk["text"])
        offset = chunk["next_offset"]


def cancel_on_interrupt(api: Api, kind: str, task_id: str) -> int:
    err(f"Cancelling {task_id}... (Ctrl-C again to stop waiting)")
    try:
        try:
            status = api.call("POST", f"/v1/{kind}/{task_id}/cancel")
        except ApiError as e:  # 409: уже завершилась
            if e.status != 409:
                raise
            status = api.get(f"/v1/{kind}/{task_id}")
        while status["state"] not in TERMINAL:
            sleep(POLL_S)
            status = api.get(f"/v1/{kind}/{task_id}")
        if status["state"] == "cancelled":
            err("Cancelled" + progress_note(status))
        else:
            err(f"The task finished before the cancel: {status['state']}")
    except KeyboardInterrupt:
        err(f"Stopped waiting; the cancel was sent. Check: {CMD} queue")
    return die_by_sigint()


def echo_summary(aggregate: dict[str, Any]) -> None:
    """Средние по повторам из summary.aggregate: ключи *_mean_over_repeats без суффикса."""
    suffix = "_mean_over_repeats"
    rows = [("repeats", aggregate.get("repeats"))] if "repeats" in aggregate else []
    rows += [(k[: -len(suffix)], v) for k, v in aggregate.items() if k.endswith(suffix)]
    width = max((len(k) for k, _ in rows), default=0)
    for key, value in rows:
        out(f"  {key:<{width}}  {number(value)}")


