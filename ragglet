    if args.json:
        emit_json(files)
        return 0
    out(table(["name", "size", "modified"], [[f["name"], size(f["size"]), short_time(f["modified_at"])] for f in files],
              right=(1,)))
    return 0


def size(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return str(n)


def cmd_runs_export(args: argparse.Namespace) -> int:
    content = Api(api_url(args)).call("GET", task_path("runs", args.id, "/artifacts.zip"), raw=True, timeout=None)
    target = Path(args.o)
    target.mkdir(parents=True, exist_ok=True)
    if args.zip:
        path = target / f"{args.id}.zip"
        path.write_bytes(content)
    else:
        path = target / args.id
        with zipfile.ZipFile(io.BytesIO(content)) as archive:
            root = target.resolve()
            for name in archive.namelist():
                if not (root / name).resolve().is_relative_to(root):
                    err(f"Refusing to extract {name}: outside {target}")
                    return 1
            archive.extractall(target)
    if args.json:
        emit_json({"path": str(path)})
    else:
        out(str(path))
    return 0


def cmd_runs_queries(args: argparse.Namespace) -> int:
    page = Api(api_url(args)).get(task_path("runs", args.id, "/queries"), outcome=args.outcome,
                                  miss_at=args.k if args.miss else None, limit=args.n)
    if args.json:
        emit_json(page)
        return 0
    wanted = [c for c in ("qid", "outcome", "first_relevant_rank", "lat_total_ms", "query") if c in page["columns"]
              or c == "first_relevant_rank"]
    rows = [[shorten(item.get(c)) for c in wanted] for item in page["items"]]
    out(table(["rank" if c == "first_relevant_rank" else c for c in wanted], rows))
    out(f"{len(page['items'])} of {page['total']} (repeat {page['repeat']}, {page['source']})")
    return 0


def shorten(value: Any, width: int = 60) -> Any:
    if isinstance(value, str) and len(value) > width:
        return value[: width - 3] + "..."
    return value


def cmd_builds_list(args: argparse.Namespace) -> int:
    page = Api(api_url(args)).get("/v1/builds", limit=args.n)
    if args.json:
        emit_json(page)
        return 0
    rows = [[i["id"], i["state"], clock(i.get("duration_s")), i["dataset"],
             ", ".join(t["collection"] for t in i.get("targets") or []), i.get("documents")] for i in page["items"]]
    out(table(["id", "state", "duration", "dataset", "targets", "documents"], rows, right=(2, 5)))
    out(f"{len(page['items'])} of {page['total']}")
    return 0


def cmd_builds_show(args: argparse.Namespace) -> int:
    build = Api(api_url(args)).get(task_path("builds", args.id))
    if args.json:
        emit_json(build)
        return 0
    out(f"id: {build['id']}")
    library = f" (library: {build['profile_id']})" if build.get("profile_id") else ""
    out(f"profile: {build['profile']}{library}")
    echo_live(build)
    out(f"dataset: {build['dataset']}")
    for t in build.get("targets") or []:
        out(f"target: {t['collection']} at {t['endpoint']}")
    result = build.get("result") or {}
    if result:
        out(f"documents: {result.get('documents')}")
    out(f"task dir: {build['build_dir']} (on the server)")
    echo_warnings("Dataset warnings", build.get("warnings") or [])
    echo_error(build)
    return 0


def cmd_indexes(args: argparse.Namespace) -> int:
    found = Api(api_url(args)).get("/v1/indexes")
    if args.json:
        emit_json(found)
        return 0
    for endpoint in found["endpoints"]:
        if not endpoint["available"]:
            err(f"{endpoint['url']}: down ({endpoint.get('error')})")
    rows = [[c["endpoint"], c["name"], c["state"], c["status"], c.get("points"), ", ".join(c.get("profiles") or []) or None,
             ", ".join(c.get("used_by") or []) or None] for c in found["collections"]]
    out(table(["endpoint", "collection", "state", "status", "points", "profiles", "used by"], rows, right=(4,)))
    return 0


