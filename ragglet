_opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # стенд локальный: без прокси


def transport(method: str, url: str, body: bytes | None, timeout: float | None) -> tuple[int, bytes]:
    """Один HTTP-запрос; тесты подменяют. Нет соединения — Unreachable."""
    headers = {"Accept": "application/json"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=body, method=method, headers=headers)
    try:
        with _opener.open(request, timeout=timeout) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        reason = getattr(e, "reason", e)
        raise Unreachable(f"cannot reach the ragglet server at {_origin(url)} ({reason})") from e


def _origin(url: str) -> str:
    parts = urllib.parse.urlsplit(url)
    return f"{parts.scheme}://{parts.netloc}"


class Api:
    def __init__(self, base: str):
        self.base = base.rstrip("/")

    def call(self, method: str, path: str, body: Any = None, *, params: dict[str, Any] | None = None,
             timeout: float | None = TIMEOUT_S, raw: bool = False) -> Any:
        query = {k: v for k, v in (params or {}).items() if v is not None and v is not False}
        url = self.base + path + ("?" + urllib.parse.urlencode(query, doseq=True) if query else "")
        data = None if body is None else json.dumps(body).encode("utf-8")
        status, content = transport(method, url, data, timeout)
        if raw and 200 <= status < 300:
            return content
        try:
            parsed = json.loads(content) if content else None
        except ValueError:
            parsed = None
        if status >= 400:
            if isinstance(parsed, dict) and "title" in parsed and "issues" in parsed:
                raise ApiError(status, parsed)
            raise Unreachable(f"{self.base} does not look like a ragglet server ({method} {path} -> {status})")
        if content and parsed is None:
            raise Unreachable(f"{self.base} does not look like a ragglet server ({method} {path}: not JSON)")
        return parsed

    def get(self, path: str, **params: Any) -> Any:
        return self.call("GET", path, params=params)


def api_url(args: argparse.Namespace) -> str:
    """--api, затем RAGGLET_API_URL, затем адрес из results/server.json, затем 127.0.0.1:8000."""
    if getattr(args, "api", None):
        return args.api
    if os.environ.get("RAGGLET_API_URL"):
        return os.environ["RAGGLET_API_URL"]
    state = read_state()
    return state.get("url") or DEFAULT_API


def read_state() -> dict[str, Any]:
    try:
        return json.loads((RESULTS / "server.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


