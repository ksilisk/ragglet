def active_kind(api: Api, task_id: str) -> str | None:
    for task in api.get("/v1/tasks"):
        if task["id"] == task_id:
            return "runs" if task["kind"] == "run" else "builds"
    return None


def cmd_cancel(args: argparse.Namespace) -> int:
    api = Api(api_url(args))
    kind = active_kind(api, args.id)
    if kind is None:
        err(f"{args.id} is not queued or running")
        return 1
    status = api.call("POST", f"/v1/{kind}/{args.id}/cancel")
    if status["state"] not in TERMINAL:
        err(f"Cancelling {args.id}...")
    while status["state"] not in TERMINAL:
        sleep(POLL_S)
        status = api.get(f"/v1/{kind}/{args.id}")
    if args.json:
        emit_json(status)
    elif status["state"] == "cancelled":
        out("Cancelled" + progress_note(status))
    else:
        out(f"Finished before the cancel: {status['state']}")
    return 0 if status["state"] == "cancelled" else 1


def log_kind(api: Api, task_id: str) -> str:
    try:
        api.get(f"/v1/runs/{task_id}")
        return "runs"
    except ApiError as e:
        if e.status != 404:
            raise
    api.get(f"/v1/builds/{task_id}")  # 404 — нет ни прогона, ни сборки
    return "builds"


def cmd_log(args: argparse.Namespace) -> int:
    api = Api(api_url(args))
    kind = log_kind(api, args.id)
    offset, parts = 0, []
    try:
        while True:
            chunk = api.get(f"/v1/{kind}/{args.id}/log", offset=offset)
            if chunk["text"]:
                offset = chunk["next_offset"]
                if args.json:
                    parts.append(chunk["text"])
                else:
                    sys.stdout.write(chunk["text"])
                    sys.stdout.flush()
                continue
            if chunk["complete"] or not args.follow:
                break
            sleep(POLL_S)
    except KeyboardInterrupt:
        return 0  # --follow: Ctrl-C только прекращает чтение, задачу не трогает
    if args.json:
        emit_json({"id": args.id, "text": "".join(parts), "next_offset": offset})
    return 0


def cmd_queue(args: argparse.Namespace) -> int:
    tasks = Api(api_url(args)).get("/v1/tasks")
    if args.json:
        emit_json(tasks)
        return 0
    if not tasks:
        out("No active tasks")
        return 0
    rows = [[t["kind"], t["id"], t["state"], t.get("position"), task_progress(t), short_time(t.get("started_at"))]
            for t in tasks]
    out(table(["kind", "id", "state", "position", "progress", "started"], rows))
    return 0


def task_progress(task: dict[str, Any]) -> str:
    p = task.get("progress")
    return f"{p['stage']} {p['done']}/{p['total']}" if p else "-"


