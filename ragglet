def out(text: str = "") -> None:
    print(text, flush=True)


def err(text: str = "") -> None:
    print(text, file=sys.stderr, flush=True)


def color(text: str, code: str, stream: Any = None) -> str:
    stream = stream or sys.stdout
    if os.environ.get("NO_COLOR") or not hasattr(stream, "isatty") or not stream.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


def emit_json(value: Any) -> None:
    out(json.dumps(value, indent=2, ensure_ascii=False))


def render_issues(title: str, issues: list[dict[str, Any]], hint: str | None = None, limit: int = 20) -> str:
    """Копия ragglet.core.issues.render_issues: где — `where`, иначе путь поля. Тест сверяет вывод."""
    n_errors = sum(1 for i in issues if i["severity"] == "error")
    n_warnings = len(issues) - n_errors
    counts = [f"{n_errors} error{'s' if n_errors != 1 else ''}"] if n_errors else []
    if n_warnings:
        counts.append(f"{n_warnings} warning{'s' if n_warnings != 1 else ''}")
    ordered = sorted(issues, key=lambda i: i["severity"] != "error")
    where = [i.get("where") or i.get("path") or "" for i in ordered]
    code_w = max((len(i["code"]) for i in ordered[:limit]), default=0)
    where_w = max((len(w) for w in where[:limit]), default=0)
    lines = [f"{title} ({', '.join(counts)})"]
    lines += [f"  {i['code']:<{code_w}}  {w:<{where_w}}  {i['message']}" for i, w in zip(ordered[:limit], where)]
    if len(ordered) > limit:
        lines.append(f"  ... and {len(ordered) - limit} more")
    if hint:
        lines.append(hint)
    return "\n".join(lines)


def echo_problem(problem: dict[str, Any]) -> None:
    err(render_issues(problem["title"], problem.get("issues") or [], problem.get("hint")))


def echo_warnings(title: str, warnings: list[dict[str, Any]]) -> None:
    if warnings:
        err(render_issues(title, warnings))


def table(headers: list[str], rows: list[list[Any]], right: tuple[int, ...] = ()) -> str:
    """Таблица фиксированной ширины; колонки с индексами из right выравниваются вправо."""
    cells = [[cell(v) for v in row] for row in rows]
    widths = [max([len(h)] + [len(r[i]) for r in cells]) for i, h in enumerate(headers)]

    def line(values: list[str]) -> str:
        return "  ".join(v.rjust(w) if i in right else v.ljust(w) for i, (v, w) in enumerate(zip(values, widths)))

    return "\n".join(line(r).rstrip() for r in [headers] + cells)


def cell(value: Any) -> str:
    if value is None:
        return "-"
    if isinstance(value, bool):
        return "yes" if value else "no"
    if isinstance(value, float):
        return number(value)
    return str(value)


def number(value: Any) -> str:
    if isinstance(value, float):
        if value != value:  # NaN
            return "-"
        return f"{value:.4f}".rstrip("0").rstrip(".") if abs(value) < 1000 else f"{value:.1f}"
    return "-" if value is None else str(value)


def parse_time(value: str | None) -> datetime | None:
    if not value:
        return None
    return datetime.fromisoformat(value.replace("Z", "+00:00"))  # 3.9: fromisoformat не знает Z


def clock(seconds: float | None) -> str:
    if seconds is None:
        return "-"
    seconds = int(round(seconds))
    hours, rest = divmod(seconds, 3600)
    return f"{hours}:{rest // 60:02d}:{rest % 60:02d}" if hours else f"{rest // 60}:{rest % 60:02d}"


def short_time(value: str | None) -> str:
    moment = parse_time(value)
    return moment.astimezone().strftime("%Y-%m-%d %H:%M") if moment else "-"


